# ── Server ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ──────────────────────────────────────────────────────
# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/flowup?retryWrites=true&w=majority

# ── Auth ──────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_64_char_random_hex

# ── Restaurant ────────────────────────────────────────────────────
# Single-tenant: the restaurant this backend instance serves.
# For multi-tenant deployments, each restaurant's data is scoped
# by restaurantId in MongoDB — this value is only the fallback for
# public endpoints (customer ordering) that have no auth context.
RESTAURANT_ID=FLOWUP001

# ── CORS origins ──────────────────────────────────────────────────
# Set to your production Netlify/Vercel URLs on Render.
# *.netlify.app is auto-allowed, so these are only needed for custom domains.
ADMIN_ORIGIN=https://your-admin.netlify.app
CUSTOMER_ORIGIN=https://your-customer.netlify.app
WAITER_ORIGIN=https://your-waiter.netlify.app

# ── Twilio — WhatsApp notifications ───────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Sandbox: whatsapp:+14155238886  |  Production: your approved number
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Email (removed) ───────────────────────────────────────────────
# Staff registration now uses Admin Approval workflow — no email/OTP needed.
# If you re-add email functionality in the future, configure SMTP here.
