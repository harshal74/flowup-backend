# ══════════════════════════════════════════════════════════════════
# FLOWUP BACKEND — Environment Configuration
# ══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to Git.

# ── Server ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ──────────────────────────────────────────────────────
# Your MongoDB Atlas connection string.
# Create at: https://cloud.mongodb.com → Cluster → Connect → Drivers
MONGO_URI=

# ── Authentication ────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST be unique per deployment. Never share across restaurants.
JWT_SECRET=

# ── Restaurant (DEPRECATED — no longer required) ─────────────────
# In multi-tenant mode, restaurantId comes from JWT (admin/staff) or
# URL query param (customer QR). This variable is NOT used by the backend.
# Keep it only if legacy single-tenant frontends still reference it.
# RESTAURANT_ID=

# ── CORS Origins ──────────────────────────────────────────────────
# Production URLs for your frontend deployments.
# *.netlify.app and *.onrender.com are auto-allowed for convenience.
# Set these when using custom domains. Example production values:
#   CUSTOMER_ORIGIN=https://app.flowup.co.in
#   ADMIN_ORIGIN=https://admin.flowup.co.in
#   WAITER_ORIGIN=https://staff.flowup.co.in
#   PLATFORM_ORIGIN=https://platform.flowup.co.in
#   LANDING_ORIGIN=https://flowup.co.in
ADMIN_ORIGIN=
CUSTOMER_ORIGIN=
WAITER_ORIGIN=
PLATFORM_ORIGIN=
LANDING_ORIGIN=

# ── Twilio — WhatsApp Notifications (optional) ───────────────────
# Leave empty to disable WhatsApp bill notifications.
# Get credentials from: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# ── Razorpay — Online Payment (optional) ─────────────────────────
# Required only if deliveryPaymentMode is PAYMENT_FIRST or BOTH.
# Get credentials from: https://dashboard.razorpay.com/app/keys
# Use TEST keys during development.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret — set in Razorpay Dashboard → Webhooks → Secret
# Required for payment reconciliation (browser-close scenario)
RAZORPAY_WEBHOOK_SECRET=

# ── SUPER_ADMIN Setup (one-time) ─────────────────────────────────
# Used ONLY by: node scripts/createSuperAdmin.js
# Set these, run the script once, then remove or leave empty.
# Do NOT commit real credentials.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ── Meta WhatsApp Cloud API (OPTIONAL — INACTIVE by default) ─────
# FlowUp uses Twilio for WhatsApp by default. The Meta Cloud API path is
# fully implemented but OUTBOUND-INACTIVE unless ALL of the following are
# provisioned AND the global flag below is explicitly "true". Leave the flag
# unset/empty (or "false") to keep Meta outbound disabled. Setting these values
# alone does NOT send anything: a restaurant must also complete Embedded Signup,
# be CONNECTED, have its per-restaurant metaOutboundEnabled=true, and have
# APPROVED templates. See the Phase 26 pilot procedure before enabling.
#
# Global Meta outbound master switch. MUST be exactly "true" to allow the Meta
# send branch to be considered at all. Missing/any-other-value => OFF (Twilio).
WHATSAPP_META_OUTBOUND_ENABLED=

# Server-side secret used to encrypt each restaurant's delegated Meta access
# token at rest (AES-256-GCM). Generate a strong random key, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER commit the real value. Absent => Meta connect/send fail safely.
WHATSAPP_TOKEN_ENC_KEY=

# Meta App configuration (from developers.facebook.com → your App).
# META_APP_ID is PUBLIC (also sent to the frontend for the JS SDK).
# META_APP_SECRET is SERVER-ONLY — never expose it to any frontend.
META_APP_ID=
META_APP_SECRET=

# Embedded Signup configuration id (from the WhatsApp Embedded Signup setup).
META_EMBEDDED_SIGNUP_CONFIG_ID=

# OAuth redirect URI registered on the Meta App (must match exactly).
#   e.g. https://admin.flowup.co.in/settings/whatsapp/callback
META_REDIRECT_URI=

# Webhook verification token (you choose this string; set the SAME value in the
# Meta App webhook config). Used only to verify the GET subscription challenge.
META_WEBHOOK_VERIFY_TOKEN=

# Non-secret Graph API pinning (optional; safe defaults applied if unset):
#   WHATSAPP_GRAPH_BASE_URL defaults to https://graph.facebook.com
#   WHATSAPP_GRAPH_VERSION  defaults to v21.0
WHATSAPP_GRAPH_BASE_URL=
WHATSAPP_GRAPH_VERSION=

# Optional legacy fallback country (ISO alpha-2, e.g. IN) for national-format
# phone numbers that arrive without an explicit country context. Unset => no
# country is ever guessed (numbers without context are skipped safely).
WHATSAPP_DEFAULT_COUNTRY=
