# ══════════════════════════════════════════════════════════════════
# FLOWUP BACKEND — Environment Configuration
# ══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to Git.

# ── Server ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ──────────────────────────────────────────────────────
# Your MongoDB Atlas connection string.
# Create at: https://cloud.mongodb.com → Cluster → Connect → Drivers
MONGO_URI=

# ── Authentication ────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST be unique per deployment. Never share across restaurants.
JWT_SECRET=

# ── Restaurant ────────────────────────────────────────────────────
# Unique identifier for this restaurant deployment.
# Used by public endpoints (customer ordering, settings lookup).
# Authenticated admin/staff routes derive restaurantId from JWT — not this.
RESTAURANT_ID=

# ── CORS Origins ──────────────────────────────────────────────────
# Production URLs for your frontend deployments.
# *.netlify.app and *.onrender.com are auto-allowed for convenience.
# Set these when using custom domains.
ADMIN_ORIGIN=
CUSTOMER_ORIGIN=
WAITER_ORIGIN=

# ── Twilio — WhatsApp Notifications (optional) ───────────────────
# Leave empty to disable WhatsApp bill notifications.
# Get credentials from: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
