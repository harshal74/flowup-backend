# Copy this file to .env and fill in the values

PORT=5000

MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/flowup?retryWrites=true&w=majority

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_64_char_random_hex

# Single-tenant restaurant identifier
RESTAURANT_ID=FLOWUP001

# CORS — set these on Render to your Netlify URLs
# *.netlify.app is auto-allowed so these are only needed for custom domains
ADMIN_ORIGIN=https://your-admin.netlify.app
CUSTOMER_ORIGIN=https://your-customer.netlify.app
