# ══════════════════════════════════════════════════════════════════
# FLOWUP BACKEND — Environment Configuration
# ══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to Git.

# ── Server ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ──────────────────────────────────────────────────────
# Your MongoDB Atlas connection string.
# Create at: https://cloud.mongodb.com → Cluster → Connect → Drivers
MONGO_URI=

# ── Authentication ────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST be unique per deployment. Never share across restaurants.
JWT_SECRET=

# ── Restaurant (DEPRECATED — no longer required) ─────────────────
# In multi-tenant mode, restaurantId comes from JWT (admin/staff) or
# URL query param (customer QR). This variable is NOT used by the backend.
# Keep it only if legacy single-tenant frontends still reference it.
# RESTAURANT_ID=

# ── CORS Origins ──────────────────────────────────────────────────
# Production URLs for your frontend deployments.
# *.netlify.app and *.onrender.com are auto-allowed for convenience.
# Set these when using custom domains. Example production values:
#   CUSTOMER_ORIGIN=https://app.flowup.co.in
#   ADMIN_ORIGIN=https://admin.flowup.co.in
#   WAITER_ORIGIN=https://staff.flowup.co.in
#   PLATFORM_ORIGIN=https://platform.flowup.co.in
#   LANDING_ORIGIN=https://flowup.co.in
ADMIN_ORIGIN=
CUSTOMER_ORIGIN=
WAITER_ORIGIN=
PLATFORM_ORIGIN=
LANDING_ORIGIN=

# ── Twilio — WhatsApp Notifications (optional) ───────────────────
# Leave empty to disable WhatsApp bill notifications.
# Get credentials from: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# ── Razorpay — Online Payment (optional) ─────────────────────────
# Required only if deliveryPaymentMode is PAYMENT_FIRST or BOTH.
# Get credentials from: https://dashboard.razorpay.com/app/keys
# Use TEST keys during development.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret — set in Razorpay Dashboard → Webhooks → Secret
# Required for payment reconciliation (browser-close scenario)
RAZORPAY_WEBHOOK_SECRET=

# ── SUPER_ADMIN Setup (one-time) ─────────────────────────────────
# Used ONLY by: node scripts/createSuperAdmin.js
# Set these, run the script once, then remove or leave empty.
# Do NOT commit real credentials.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
